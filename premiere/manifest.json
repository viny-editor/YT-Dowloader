{
  "id": "local.ytdownloader.premiere",
  "name": "YT Downloader",
  "version": "2.13.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "read",
    "launchProcess": {
      "schemes": ["https"],
      "extensions": ["app", "exe", "lnk"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ytdownloader",
      "label": {
        "default": "YT Downloader"
      },
      "minimumSize": { "width": 280, "height": 380 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 340, "height": 620 },
      "preferredFloatingSize": { "width": 360, "height": 640 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
